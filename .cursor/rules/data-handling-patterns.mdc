# Data Handling Patterns

This project follows strict patterns for data operations. **CRITICAL**: All data retrieval must use server components, all mutations must use server actions, all data must be validated with Zod, and all database operations must use helper functions from the `db/queries` directory.

## Core Principles

### 1. Database Query Helpers - MANDATORY
**ALL database operations must use helper functions from the `db/queries` directory.**

#### Query Helper Structure
```
src/db/queries/
├── deck-queries.ts    # Deck-related database operations
├── card-queries.ts    # Card-related database operations
└── index.ts          # Export all query functions
```

#### Example Query Helper Functions
```typescript
// src/db/queries/deck-queries.ts
import { db } from '@/src/db';
import { decksTable, cardsTable } from '@/src/db/schema';
import { eq, and, desc } from 'drizzle-orm';

export async function getDecksByUserId(userId: string) {
  return await db.select()
    .from(decksTable)
    .where(eq(decksTable.userId, userId))
    .orderBy(desc(decksTable.createdAt));
}

export async function getDeckById(deckId: number, userId: string) {
  const result = await db.select()
    .from(decksTable)
    .where(and(
      eq(decksTable.id, deckId),
      eq(decksTable.userId, userId)
    ))
    .limit(1);
    
  return result[0] || null;
}

export async function getDeckWithCards(deckId: number, userId: string) {
  return await db
    .select()
    .from(decksTable)
    .leftJoin(cardsTable, eq(decksTable.id, cardsTable.deckId))
    .where(and(
      eq(decksTable.id, deckId),
      eq(decksTable.userId, userId)
    ));
}

export async function createDeck(data: { name: string; description?: string; userId: string }) {
  const [newDeck] = await db.insert(decksTable).values(data).returning();
  return newDeck;
}

export async function updateDeck(deckId: number, userId: string, data: { name?: string; description?: string }) {
  await db.update(decksTable)
    .set(data)
    .where(and(
      eq(decksTable.id, deckId),
      eq(decksTable.userId, userId)
    ));
}

export async function deleteDeck(deckId: number, userId: string) {
  await db.delete(decksTable)
    .where(and(
      eq(decksTable.id, deckId),
      eq(decksTable.userId, userId)
    ));
}
```

```typescript
// src/db/queries/card-queries.ts
import { db } from '@/src/db';
import { cardsTable, decksTable } from '@/src/db/schema';
import { eq, and } from 'drizzle-orm';

export async function getCardsByDeckId(deckId: number, userId: string) {
  return await db
    .select()
    .from(cardsTable)
    .innerJoin(decksTable, eq(cardsTable.deckId, decksTable.id))
    .where(and(
      eq(cardsTable.deckId, deckId),
      eq(decksTable.userId, userId)
    ));
}

export async function getCardById(cardId: number, userId: string) {
  const result = await db
    .select()
    .from(cardsTable)
    .innerJoin(decksTable, eq(cardsTable.deckId, decksTable.id))
    .where(and(
      eq(cardsTable.id, cardId),
      eq(decksTable.userId, userId)
    ))
    .limit(1);
    
  return result[0] || null;
}

export async function createCard(data: { deckId: number; front: string; back: string }) {
  const [newCard] = await db.insert(cardsTable).values(data).returning();
  return newCard;
}

export async function updateCard(cardId: number, userId: string, data: { front?: string; back?: string }) {
  await db.update(cardsTable)
    .set(data)
    .where(and(
      eq(cardsTable.id, cardId),
      // Verify ownership through deck
      eq(cardsTable.deckId, 
        db.select({ deckId: decksTable.id })
          .from(decksTable)
          .where(and(
            eq(decksTable.id, cardsTable.deckId),
            eq(decksTable.userId, userId)
          ))
      )
    ));
}

export async function deleteCard(cardId: number, userId: string) {
  await db.delete(cardsTable)
    .where(and(
      eq(cardsTable.id, cardId),
      // Verify ownership through deck
      eq(cardsTable.deckId,
        db.select({ deckId: decksTable.id })
          .from(decksTable)
          .where(and(
            eq(decksTable.id, cardsTable.deckId),
            eq(decksTable.userId, userId)
          ))
      )
    ));
}
```

